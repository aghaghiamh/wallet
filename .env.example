# Defaults for Python on the host with Compose postgres/redis.
PGHOST=127.0.0.1
PGPORT=55432
PGUSER=wallet
PGPASSWORD=wallet
PGDATABASE=wallet
PROVIDER_DATABASE=provider
CELERY_BROKER_URL=redis://127.0.0.1:56379/0
PROVIDER_URL=http://127.0.0.1:8001
# All wallet pods must share this value (it signs pagination cursors).
SECRET_KEY=local-demo-shared-secret
